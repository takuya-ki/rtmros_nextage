Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 803
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Image_head_L
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        BDU:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        CAMERA_HEAD_L_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        CAMERA_HEAD_R_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        CHEST_JOINT0_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        HEAD_JOINT0_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        HEAD_JOINT1_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        LARM_JOINT0_Link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
