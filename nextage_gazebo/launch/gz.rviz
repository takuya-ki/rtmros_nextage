          Value: true
        LARM_JOINT2_Link:
          Value: true
        LARM_JOINT3_Link:
          Value: true
        LARM_JOINT4_Link:
          Value: true
        LARM_JOINT5_Link:
          Value: true
        OPERATOR:
          Value: true
        RARM_JOINT0_Link:
          Value: true
        RARM_JOINT1_Link:
          Value: true
        RARM_JOINT2_Link:
          Value: true
        RARM_JOINT3_Link:
          Value: true
        RARM_JOINT4_Link:
          Value: true
        RARM_JOINT5_Link:
          Value: true
        WAIST:
          Value: true
        WORKTABLE:
          Value: true
        world:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          BDU:
            {}
          OPERATOR:
            {}
          WAIST:
            CHEST_JOINT0_Link:
              HEAD_JOINT0_Link:
                HEAD_JOINT1_Link:
                  CAMERA_HEAD_L_Link:
                    {}
                  CAMERA_HEAD_R_Link:
                    {}
              LARM_JOINT0_Link:
                LARM_JOINT1_Link:
                  LARM_JOINT2_Link:
                    LARM_JOINT3_Link:
                      LARM_JOINT4_Link:
                        LARM_JOINT5_Link:
                          {}
              RARM_JOINT0_Link:
                RARM_JOINT1_Link:
                  RARM_JOINT2_Link:
                    RARM_JOINT3_Link:
                      RARM_JOINT4_Link:
                        RARM_JOINT5_Link:
                          {}
            WORKTABLE:
              {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: WAIST
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.2965996265411377
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.514764666557312
        Y: -0.3858935832977295
        Z: -0.240507110953331
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5803988575935364
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.6304047703742981
    Saved: ~
